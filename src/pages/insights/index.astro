---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/PageHero.astro';import {getCollection} from 'astro:content';const articles=(await getCollection('articles',(entry)=>!entry.data.draft)).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<BaseLayout title="الرؤى والمقالات" description="رؤى MGBC حول التخطيط المالي والالتزام الضريبي ودراسات الجدوى في السوق السعودي."><PageHero eyebrow="مركز المعرفة" title="رؤى تساعدك قبل القرار" description="مقالات عملية ومباشرة لأصحاب الأعمال والمستثمرين حول أكثر القضايا المالية والضريبية تأثيرًا."/><section class="section"><div class="container"><div class="cards-grid">{articles.map((a)=><article class="article-card"><span class="category">{a.data.category}</span><h3><a href={`/insights/${a.data.slug}`}>{a.data.title}</a></h3><p>{a.data.excerpt}</p><div class="article-meta">{a.data.publishedAt.toLocaleDateString('ar-SA',{year:'numeric',month:'long',day:'numeric'})}</div></article>)}</div></div></section></BaseLayout>
