---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/PageHero.astro';import Icon from '@/components/Icon.astro';import site from '@/data/settings/site.json';
---
<BaseLayout title="تواصل معنا" description="تواصل مع MGBC لطلب استشارة مالية أو ضريبية أو دراسة جدوى في المملكة العربية السعودية."><PageHero title="حدثنا عن التحدي الذي تواجهه" description="أرسل نبذة مختصرة عن نشاطك والتحدي الحالي، أو ابدأ بالتقييم المجاني إذا كنت لا تزال تحدد نقطة البداية."/><section class="section"><div class="container contact-grid"><aside class="contact-card"><h2>قناة مباشرة مع فريق الاستشارات</h2><p>كلما كانت المعلومات محددة، استطعنا فهم الاحتياج بصورة أفضل وتوجيه الخطوة التالية.</p><p><strong>البريد</strong><br/><a href={`mailto:${site.email}`}>{site.email}</a></p><p><strong>النطاق</strong><br/>{site.location}</p><a class="btn btn--primary" href="/consultation"><Icon name="arrow"/>ابدأ التقييم المجاني</a></aside><div class="form-card"><h2>أرسل رسالة</h2><form id="contact-form" class="form-grid" novalidate><div class="hp-field" aria-hidden="true"><label for="contact-website">الموقع الإلكتروني</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off"/></div><div class="field"><label for="contact-name">الاسم</label><input id="contact-name" name="name" autocomplete="name" maxlength="100" required placeholder="مثال: محمد أحمد…"/></div><div class="field"><label for="contact-email">البريد الإلكتروني</label><input id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" maxlength="160" required placeholder="name@company.com…"/></div><div class="field"><label for="contact-phone">رقم الجوال <span class="form-note">(اختياري)</span></label><input id="contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" placeholder="05xxxxxxxx…"/></div><div class="field"><label for="contact-company">الشركة أو المشروع <span class="form-note">(اختياري)</span></label><input id="contact-company" name="company" autocomplete="organization" maxlength="140" placeholder="اسم المنشأة…"/></div><div class="field field--full"><label for="contact-subject">موضوع الاستشارة</label><select id="contact-subject" name="service" autocomplete="off" required><option value="">اختر الموضوع</option><option>الاستشارات المالية</option><option>الاستشارات الضريبية</option><option>دراسات الجدوى</option><option>استفسار عام</option></select></div><div class="field field--full"><label for="contact-message">التفاصيل</label><textarea id="contact-message" name="challenge" maxlength="1600" required placeholder="اكتب التحدي والنتيجة التي تريد الوصول إليها…"></textarea></div><div class="field--full"><button class="btn btn--dark" type="submit" id="contact-submit"><Icon name="mail"/>إرسال الرسالة</button><p id="contact-status" class="form-status" role="status" aria-live="polite"></p><p class="form-note">باستخدام النموذج، ترسل البيانات مباشرة إلى MGBC. يمكنك أيضًا مراسلتنا عبر <a href={`mailto:${site.email}`}>{site.email}</a>.</p></div></form></div></div></section><script is:inline>const form=document.querySelector('#contact-form');const button=document.querySelector('#contact-submit');const status=document.querySelector('#contact-status');const original=button?.innerHTML||'إرسال الرسالة';const setStatus=(text,state='')=>{status.textContent=text;status.dataset.state=state};const focusInvalid=()=>{const invalid=form?.querySelector(':invalid');if(invalid){invalid.focus();invalid.reportValidity();return true}return false};form?.addEventListener('submit',async(event)=>{event.preventDefault();if(focusInvalid())return;const data=Object.fromEntries(new FormData(form).entries());const q=new URLSearchParams(location.search);const payload={...data,source:'contact',utmSource:q.get('utm_source')||'',utmMedium:q.get('utm_medium')||'',utmCampaign:q.get('utm_campaign')||'',utmContent:q.get('utm_content')||'',utmTerm:q.get('utm_term')||'',landingPage:location.href,referrer:document.referrer||''};button.disabled=true;button.textContent='جارٍ إرسال الرسالة…';setStatus('جارٍ إرسال بياناتك…');try{const response=await fetch('/api/leads',{method:'POST',headers:{'content-type':'application/json','accept':'application/json'},body:JSON.stringify(payload)});const body=await response.json().catch(()=>({}));if(!response.ok||!body.ok)throw new Error(body.message||'تعذر إرسال الرسالة الآن.');form.reset();setStatus('تم استلام رسالتك بنجاح.','success')}catch(error){setStatus(`${error.message} يمكنك إعادة المحاولة أو استخدام البريد المباشر.`,'error')}finally{button.disabled=false;button.innerHTML=original}});</script></BaseLayout>