---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Icon from '@/components/Icon.astro'; import ServiceCard from '@/components/ServiceCard.astro'; import CTA from '@/components/CTA.astro'; import site from '@/data/settings/site.json'; import faqs from '@/data/faqs.json'; import { getCollection } from 'astro:content';
const services=(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order);const articles=(await getCollection('articles',(entry)=>!entry.data.draft)).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,3);
const organization={ '@context':'https://schema.org','@type':'ProfessionalService',name:site.name,url:site.domain,email:site.email,areaServed:'SA',description:site.description,serviceType:['الاستشارات المالية','الاستشارات الضريبية','دراسات الجدوى']};
---
<BaseLayout title="استشارات مالية وضريبية في السعودية" description={site.description} jsonLd={organization}>
<section class="hero"><div class="container"><div class="hero-shell"><div class="hero-content"><span class="eyebrow">استشارات مالية · ضريبية · دراسات جدوى</span><h1>قرارات مالية <span>أوضح</span> في السوق السعودي</h1><p class="hero-copy">نحوّل الأرقام والأنظمة والتحديات التشغيلية إلى توصيات عملية تساعدك على اتخاذ القرار بثقة، من مرحلة التأسيس إلى التوسع.</p><div class="hero-actions"><a class="btn btn--primary" href="/consultation"><Icon name="calendar"/>ابدأ التقييم المجاني</a><a class="btn btn--secondary" href="#services">استكشف الخدمات <Icon name="arrow"/></a></div><div class="hero-trust"><span class="trust-item"><i class="trust-dot"></i>خبرة تتجاوز {site.experienceYears} أعوام</span><span class="trust-item"><i class="trust-dot"></i>متخصصون في الأنظمة السعودية</span><span class="trust-item"><i class="trust-dot"></i>توصيات قابلة للتنفيذ</span></div></div><div class="hero-visual" aria-hidden="true"><div class="growth-card"><img class="growth-logo" src="/images/mgbc-logo-mark.png" alt=""/><div class="growth-metric growth-metric--one"><small>من البيانات إلى</small>قرار واضح</div><div class="growth-metric growth-metric--two"><small>من التحدي إلى</small>خطة قابلة للتنفيذ</div></div></div></div><div class="stats-band"><div class="stats-grid"><div class="stat"><strong>+{site.experienceYears}</strong><span>سنوات خبرة في السوق السعودي</span></div><div class="stat"><strong>3</strong><span>مسارات استشارية متخصصة</span></div><div class="stat"><strong>30</strong><span>دقيقة لجلسة التشخيص الأولى</span></div></div></div></div></section>
<section class="section" id="services"><div class="container"><span class="eyebrow">خدماتنا</span><h2 class="section-title">الوضوح الذي يحتاجه القرار</h2><p class="section-lead">ثلاث خدمات مترابطة تغطي الاحتياجات الأساسية للمشروع في مرحلة التأسيس والتشغيل والتوسع داخل المملكة.</p><div class="cards-grid">{services.map((s)=><ServiceCard title={s.data.title} summary={s.data.summary} slug={s.data.slug} icon={s.data.icon}/>)}</div></div></section>
<section class="section section--soft"><div class="container split"><div><span class="eyebrow">من نحن</span><h2 class="section-title">شركاؤك في الوضوح المالي</h2><p class="section-lead">نعمل مع الشركات والمستثمرين الذين يحتاجون إلى فهم حقيقي لبيئة الأعمال المحلية قبل اتخاذ قراراتهم.</p><div class="about-list"><div class="check-item"><span class="check-icon"><Icon name="check"/></span><div><strong>خبرة محلية حقيقية</strong><br/><span style="color:var(--muted)">عمل فعلي داخل السوق السعودي، وليس معرفة نظرية فقط.</span></div></div><div class="check-item"><span class="check-icon"><Icon name="check"/></span><div><strong>تخصص دون تشتيت</strong><br/><span style="color:var(--muted)">تركيز على المالية والضريبة ودراسات الجدوى.</span></div></div><div class="check-item"><span class="check-icon"><Icon name="check"/></span><div><strong>مخرجات عملية</strong><br/><span style="color:var(--muted)">توصيات واضحة يمكن للإدارة تطبيقها ومتابعتها.</span></div></div></div><a class="btn btn--dark" href="/about" style="margin-top:30px">تعرف على MGBC</a></div><div class="about-panel reveal"><span class="quote-mark">“</span><blockquote class="quote">الاستشارة الجيدة لا تقدم إجابات جاهزة، بل تبني لدى العميل القدرة على اتخاذ قرارات مالية مستنيرة ومستدامة.</blockquote></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">منهجية العمل</span><h2 class="section-title">من التشخيص إلى المتابعة</h2><p class="section-lead">مسار واضح يمنع تضخم نطاق العمل ويضمن أن ترتبط كل توصية بهدف وقرار.</p><div class="process"><div class="process-step"><span>01</span><h3>تشخيص</h3><p>فهم النشاط والمرحلة والتحدي الحقيقي.</p></div><div class="process-step"><span>02</span><h3>تحليل</h3><p>مراجعة البيانات والافتراضات والمتطلبات.</p></div><div class="process-step"><span>03</span><h3>خطة</h3><p>تحديد الأولويات والنطاق والمخرجات.</p></div><div class="process-step"><span>04</span><h3>تنفيذ</h3><p>تحويل الخطة إلى أدوات وتوصيات عملية.</p></div><div class="process-step"><span>05</span><h3>متابعة</h3><p>قياس التقدم وتصحيح المسار عند الحاجة.</p></div></div></div></section>
<section class="section section--soft"><div class="container"><span class="eyebrow">رؤى عملية</span><h2 class="section-title">معرفة تساعدك قبل القرار</h2><p class="section-lead">محتوى مبسط حول التخطيط المالي والالتزام الضريبي ودراسة الفرص في السوق السعودي.</p><div class="insights-grid">{articles.map((a,i)=><article class:list={['article-card','reveal',{'article-card--featured':i===0}]}><span class="category">{a.data.category}</span><h3><a href={`/insights/${a.data.slug}`}>{a.data.title}</a></h3><p>{a.data.excerpt}</p><div class="article-meta">{a.data.publishedAt.toLocaleDateString('ar-SA',{year:'numeric',month:'long',day:'numeric'})}</div></article>)}</div></div></section>
<section class="section"><div class="container"><span class="eyebrow">الأسئلة الشائعة</span><h2 class="section-title">قبل أن تبدأ</h2><div class="faq-list">{faqs.map((item)=><details class="faq-item"><summary>{item.question}</summary><div class="faq-answer">{item.answer}</div></details>)}</div></div></section><CTA/>
</BaseLayout>
