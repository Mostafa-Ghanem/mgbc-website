---
import BaseLayout from '@/layouts/BaseLayout.astro';import Icon from '@/components/Icon.astro';import ServiceCard from '@/components/ServiceCard.astro';import CTA from '@/components/CTA.astro';import site from '@/data/settings/site.json';import faqs from '@/data/faqs.json';import {getCollection} from 'astro:content';
const services=(await getCollection('services')).sort((a,b)=>a.data.order-b.data.order);const articles=(await getCollection('articles',(entry)=>!entry.data.draft)).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,3);const dateFormat=new Intl.DateTimeFormat('ar-SA',{year:'numeric',month:'long',day:'numeric'});const organization={'@context':'https://schema.org','@type':'ProfessionalService',name:site.name,url:site.domain,email:site.email,areaServed:'SA',description:site.description,serviceType:['الاستشارات المالية','الاستشارات الضريبية','دراسات الجدوى']};
---
<BaseLayout title="استشارات مالية وضريبية في السعودية" description={site.description} jsonLd={organization}>
<section class="hero"><div class="container"><div class="hero-shell"><div class="hero-content"><h1>قرارات مالية <span>أوضح</span> في السوق السعودي</h1><p class="hero-copy">نحوّل الأرقام والأنظمة والتحديات التشغيلية إلى توصيات عملية تساعدك على اتخاذ القرار بثقة، من مرحلة التأسيس إلى التوسع.</p><div class="hero-actions"><a class="btn btn--primary" href="/consultation"><Icon name="arrow"/>ابدأ التقييم المجاني</a><a class="btn btn--secondary" href="#services">استكشف الخدمات <Icon name="arrow"/></a></div><div class="hero-trust" aria-label="مزايا أسلوب العمل"><span class="trust-item"><i class="trust-dot" aria-hidden="true"></i>خبرة تتجاوز {site.experienceYears} أعوام</span><span class="trust-item"><i class="trust-dot" aria-hidden="true"></i>فهم لبيئة الأعمال السعودية</span><span class="trust-item"><i class="trust-dot" aria-hidden="true"></i>توصيات قابلة للتنفيذ</span></div></div><div class="hero-visual" aria-hidden="true"><div class="growth-stage"><img class="growth-logo" src="/images/mgbc-logo-mark.png" width="619" height="484" alt="" fetchpriority="high"/></div></div></div></div></section>
<section class="section" id="services"><div class="container"><div class="section-head"><h2 class="section-title">الوضوح الذي يحتاجه القرار</h2><p class="section-lead">ثلاث خدمات مترابطة تغطي الاحتياجات الأساسية للمشروع في مرحلة التأسيس والتشغيل والتوسع داخل المملكة.</p></div><div class="services-editorial">{services.map((s)=><ServiceCard title={s.data.title} summary={s.data.summary} slug={s.data.slug} icon={s.data.icon}/>)}</div></div></section>
<section class="section section--soft"><div class="container split"><div class="about-copy"><h2 class="section-title">شركاؤك في الوضوح المالي</h2><p class="section-lead">نعمل مع الشركات والمستثمرين الذين يحتاجون إلى فهم حقيقي لبيئة الأعمال المحلية قبل اتخاذ قراراتهم.</p><div class="about-list"><div class="check-item"><span class="check-icon"><Icon name="check"/></span><div><strong>خبرة محلية</strong><br/><span>عمل فعلي داخل السوق السعودي، وليس معرفة نظرية فقط.</span></div></div><div class="check-item"><span class="check-icon"><Icon name="check"/></span><div><strong>تخصص دون تشتيت</strong><br/><span>تركيز على المالية والضريبة ودراسات الجدوى.</span></div></div><div class="check-item"><span class="check-icon"><Icon name="check"/></span><div><strong>مخرجات عملية</strong><br/><span>توصيات واضحة يمكن للإدارة تطبيقها ومتابعتها.</span></div></div></div><div><a class="btn btn--dark" href="/about">تعرف على MGBC</a></div></div><div class="about-panel"><span class="quote-mark" aria-hidden="true">“</span><blockquote class="quote">الاستشارة الجيدة لا تقدم إجابات جاهزة، بل تبني لدى العميل القدرة على اتخاذ قرارات مالية مستنيرة ومستدامة.</blockquote></div></div></section>
<section class="section"><div class="container market-story"><figure class="market-media"><img src="https://images.unsplash.com/photo-1784637729389-f24e1d2a8b22?auto=format&fit=crop&w=1600&q=78" width="1500" height="1000" loading="lazy" decoding="async" alt="مشهد حضري من مدينة الرياض يعكس بيئة الأعمال في المملكة العربية السعودية"/><figcaption>الرياض — صورة: Tati Odintsova / Unsplash</figcaption></figure><div class="market-copy"><h2>السياق المحلي جزء من جودة القرار</h2><p>القرارات المالية والضريبية لا تنفصل عن بيئة العمل التي تُتخذ فيها. لذلك نضع طبيعة النشاط ومرحلة الشركة والسوق السعودي في قلب التشخيص قبل تقديم التوصية.</p><div><a class="text-link" href="/about">كيف نعمل مع العملاء <Icon name="arrow"/></a></div></div></div></section>
<section class="section section--soft"><div class="container"><div class="section-head"><h2 class="section-title">من التشخيص إلى المتابعة</h2><p class="section-lead">مسار واضح يمنع تضخم نطاق العمل ويضمن أن ترتبط كل توصية بهدف وقرار.</p></div><div class="process"><div class="process-step"><span>01</span><h3>تشخيص</h3><p>فهم النشاط والمرحلة والتحدي الحقيقي.</p></div><div class="process-step"><span>02</span><h3>تحليل</h3><p>مراجعة البيانات والافتراضات والمتطلبات.</p></div><div class="process-step"><span>03</span><h3>خطة</h3><p>تحديد الأولويات والنطاق والمخرجات.</p></div><div class="process-step"><span>04</span><h3>تنفيذ</h3><p>تحويل الخطة إلى أدوات وتوصيات عملية.</p></div><div class="process-step"><span>05</span><h3>متابعة</h3><p>قياس التقدم وتصحيح المسار عند الحاجة.</p></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><h2 class="section-title">معرفة تساعدك قبل القرار</h2><p class="section-lead">محتوى مبسط حول التخطيط المالي والالتزام الضريبي ودراسة الفرص في السوق السعودي.</p></div><div class="insights-list">{articles.map((a)=><article class="article-row"><div><span class="category">{a.data.category}</span><h3><a href={`/insights/${a.data.slug}`}>{a.data.title}</a></h3><p>{a.data.excerpt}</p></div><div class="article-meta">{dateFormat.format(a.data.publishedAt)}</div></article>)}</div></div></section>
<section class="section section--soft"><div class="container"><div class="section-head"><h2 class="section-title">قبل أن تبدأ</h2><p class="section-lead">إجابات مختصرة عن أكثر الأسئلة التي تساعدك على تحديد الخطوة التالية.</p></div><div class="faq-list">{faqs.map((item)=><details class="faq-item"><summary>{item.question}</summary><div class="faq-answer">{item.answer}</div></details>)}</div></div></section><CTA/></BaseLayout>