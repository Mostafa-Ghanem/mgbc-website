---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/home/HomePage.astro';

const homePage = (await getCollection('pages')).find((entry) => entry.data.pageType === 'home');
if (!homePage) throw new Error('Missing home-ar content entry');
---
<BaseLayout title={homePage.data.seoTitle} description={homePage.data.metaDescription} canonical={homePage.data.canonical} pageType="home"><HomePage/></BaseLayout>
