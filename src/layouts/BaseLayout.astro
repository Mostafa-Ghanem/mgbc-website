---
import '../styles/global.css';
import GlobalHeader from '../components/global/GlobalHeader.astro';
import GlobalFooter from '../components/global/GlobalFooter.astro';
import { site } from '../data/site';
interface Props { title:string; description:string; canonical?:string; robots?:string; pageType?:string; noFooter?:boolean; }
const { title, description, canonical=site.url + Astro.url.pathname, robots='index,follow', pageType='page', noFooter=false } = Astro.props;
const organizationId=`${site.url}#organization`;
const websiteId=`${site.url}#website`;
const imageUrl=`${site.url}/brand/mgbc-logo-gold.webp`;
const pageId=`${canonical}#page`;
const pageTypeSchema=pageType==='about'?'AboutPage':pageType==='contact'?'ContactPage':pageType==='servicesHub'||pageType==='insightsHub'?'CollectionPage':'WebPage';
const organization={ '@type':'Organization', '@id':organizationId, name:site.name, url:site.url, logo:{ '@type':'ImageObject', url:imageUrl } };
const website={ '@type':'WebSite', '@id':websiteId, name:site.name, url:site.url, inLanguage:site.locale };
function buildPageEntity(){
  const baseEntity={ '@id':pageId, name:title, description, url:canonical, inLanguage:site.locale, isPartOf:{ '@id':websiteId } };
  if(pageType==='service') return { ...baseEntity, '@type':'Service', serviceType:title, areaServed:{ '@type':'Country', name:'Saudi Arabia' }, provider:{ '@id':organizationId } };
  if(pageType==='insight') return { ...baseEntity, '@type':'Article', headline:title, mainEntityOfPage:canonical, author:{ '@id':organizationId }, publisher:{ '@id':organizationId } };
  return { ...baseEntity, '@type':pageType==='home'?'WebSite':pageTypeSchema };
}
const pageEntity=buildPageEntity();
const breadcrumbs=Astro.url.pathname==='/' ? [] : [{ '@type':'ListItem', position:1, name:'الرئيسية', item:`${site.url}/` },{ '@type':'ListItem', position:2, name:title, item:canonical }];
const jsonLd={ '@context':'https://schema.org', '@graph':[organization,website,pageEntity,...(breadcrumbs.length ? [{ '@type':'BreadcrumbList', itemListElement:breadcrumbs }] : [])] };
const jsonLdText=JSON.stringify(jsonLd).replace(/</g,'\\u003c');
const socialImageAlt='شعار MGBC';
---
<!doctype html><html lang={site.lang} dir={site.direction}><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content={robots}/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/><meta property="og:locale" content={site.locale.replace('-','_')}/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageUrl}/><meta property="og:image:alt" content={socialImageAlt}/>
<meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageUrl}/><meta name="twitter:image:alt" content={socialImageAlt}/><meta name="theme-color" content="#03111F"/>

<script is:inline type="application/ld+json" set:html={jsonLdText}></script>
</head><body data-page-type={pageType}><GlobalHeader/><main><slot/></main>{!noFooter && <GlobalFooter/>}
<script>
  import { captureInitialAttribution } from '../lib/leadAttribution';
  captureInitialAttribution();
</script>
</body></html>
