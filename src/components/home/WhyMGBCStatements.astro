---
import type { HomeSection } from '../../data/home-types';
interface Props { section:HomeSection; }
const { section } = Astro.props;
---
<section class="section section--lg section--paper"><div class="container why-grid"><div><span class="eyebrow">منهج التفكير</span><h2 class="h2 section-heading">{section.title}</h2></div><div class="why-statements">{section.items.map((item)=><article class="why-statement"><h3>{item.title}</h3>{item.body.map((p:string)=><p>{p}</p>)}</article>)}</div></div></section>
