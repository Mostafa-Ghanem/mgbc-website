---
import Icon from './Icon.astro';interface Props { title:string; summary:string; slug:string; icon:'chart'|'tax'|'study' }const {title,summary,slug,icon}=Astro.props;
---
<article class="service-row"><div class="service-icon"><Icon name={icon}/></div><h3>{title}</h3><p>{summary}</p><a class="text-link" href={`/services/${slug}`}>تفاصيل الخدمة <Icon name="arrow"/></a></article>