<form class="assessment" id="assessment-form" method="post" action="/consultation/">
  <section class="form-section"><h2>البيانات الأساسية</h2><div class="form-grid">
    <div class="field"><label for="a-name">الاسم</label><input id="a-name" name="name" autocomplete="name" required /></div>
    <div class="field"><label for="a-email">البريد الإلكتروني</label><input id="a-email" name="email" type="email" autocomplete="email" required /></div>
    <div class="field"><label for="a-phone">رقم الجوال <span class="muted">— اختياري</span></label><input id="a-phone" name="phone" type="tel" autocomplete="tel" /></div>
    <div class="field"><label for="a-company">اسم الشركة أو المشروع</label><input id="a-company" name="company" required /></div>
    <div class="field"><label for="a-site">الموقع الإلكتروني <span class="muted">— اختياري</span></label><input id="a-site" name="website" type="url" inputmode="url" /></div>
    <div class="field"><label for="a-team">حجم الفريق</label><select id="a-team" name="team"><option>1–5</option><option>6–20</option><option>21–50</option><option>أكثر من 50</option></select></div>
    <div class="field field--full"><label for="a-service">الخدمة الأقرب للاحتياج</label><select id="a-service" name="service"><option>الاستشارات المالية</option><option>الاستشارات الزكوية والضريبية</option><option>دراسات الجدوى</option><option>غير متأكد وأحتاج إلى تشخيص</option></select></div>
  </div></section>
  <section class="form-section"><h2>أسئلة الجاهزية</h2><fieldset><legend>هل توجد تقارير مالية دورية تساعد الإدارة على اتخاذ القرار؟</legend><div class="choice-grid"><label class="choice"><input type="radio" name="reports" value="yes" required/>نعم، بانتظام.</label><label class="choice"><input type="radio" name="reports" value="review"/>لا، أو بصورة غير منتظمة.</label></div></fieldset></section>
  <section class="form-section"><fieldset><legend>هل التدفقات النقدية المتوقعة للفترة القادمة واضحة للإدارة؟</legend><div class="choice-grid"><label class="choice"><input type="radio" name="cashflow" value="yes" required/>نعم.</label><label class="choice"><input type="radio" name="cashflow" value="review"/>لا / غير متأكد.</label></div></fieldset></section>
  <section class="form-section"><fieldset><legend>هل الوضع الزكوي والضريبي موثق وتتم مراجعته قبل الاستحقاقات أو الإجراءات المهمة؟</legend><div class="choice-grid"><label class="choice"><input type="radio" name="tax" value="yes" required/>نعم.</label><label class="choice"><input type="radio" name="tax" value="review"/>لا / توجد نقاط تحتاج إلى مراجعة.</label></div></fieldset></section>
  <section class="form-section"><fieldset><legend>هل قرارات التوسع أو الاستثمار تُختبر من خلال افتراضات وسيناريوهات مالية؟</legend><div class="choice-grid"><label class="choice"><input type="radio" name="scenario" value="yes" required/>نعم.</label><label class="choice"><input type="radio" name="scenario" value="review"/>غالبًا لا / نحتاج إلى تطوير ذلك.</label></div></fieldset></section>
  <div class="field"><label for="a-challenge">ما التحدي الأهم الآن؟</label><textarea id="a-challenge" name="challenge" maxlength="1500" placeholder="صف القرار أو المشكلة بلغتك، دون إدخال مستندات أو معلومات شديدة الحساسية."></textarea></div>
  <p class="form-note">التقييم الإلكتروني نحو 3 دقائق، ولا يمثل رأيًا ماليًا أو زكويًا أو ضريبيًا نهائيًا. لا تضع مستندات سرية أو معلومات شديدة الحساسية هنا.</p>
  <noscript><p class="form-note">يتطلب عرض الملخص الأولي تفعيل JavaScript. لا ترسل معلومات شديدة الحساسية عبر هذا النموذج.</p></noscript>
  <div class="button-row"><button class="button button--dark" type="submit">اعرض الملخص الأولي</button></div>
  <div class="assessment-result" id="assessment-result" role="status" aria-live="polite"></div>
</form>
<script>
  const form=document.querySelector('#assessment-form');
  const result=document.querySelector('#assessment-result');
  const readinessKeys=['reports','cashflow','tax','scenario'] as const;
  type ReadinessKey=(typeof readinessKeys)[number];
  const labels:Record<ReadinessKey,string>={reports:'التقارير الإدارية',cashflow:'وضوح التدفقات النقدية',tax:'الجاهزية الزكوية والضريبية',scenario:'اختبار سيناريوهات القرار'};
  form?.addEventListener('submit',(event)=>{
    event.preventDefault();
    if(!(form instanceof HTMLFormElement)||!(result instanceof HTMLElement)) return;
    const data=new FormData(form);
    const review=readinessKeys.filter((key)=>data.get(key)==='review');
    const focus=review.length?review.map((key)=>labels[key]).join('، '):'الحفاظ على انتظام المراجعة وربط المؤشرات بالقرار';
    result.innerHTML=`<strong>نقطة البداية المقترحة للمناقشة:</strong><br>${focus}.<br><small>هذا ملخص توجيهي مبني على إجاباتك، وليس تشخيصًا أو رأيًا مهنيًا نهائيًا.</small><div class="assessment-result__link"><a class="button button--primary" href="/contact/">ناقش النتيجة مع MGBC</a></div>`;
    result.dataset.visible='true';
    result.scrollIntoView({behavior:'smooth',block:'center'});
  });
</script>
