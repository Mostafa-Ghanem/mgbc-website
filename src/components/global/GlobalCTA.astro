---
import { site } from '../../data/site';
interface Props { title?: string; description?: string; }
const { title='حوّل التحدي إلى نقطة بداية واضحة', description='ابدأ بتقييم أولي قصير يساعدنا على فهم وضعك الحالي وتحديد المجال الذي يستحق النقاش أولًا.' } = Astro.props;
---
<section class="section"><div class="container"><div class="global-cta"><div class="global-cta__content"><div><span class="eyebrow">الخطوة التالية</span><h2 class="h2 section-heading">{title}</h2><p class="lead">{description}</p></div><div class="button-row"><a class="button button--primary" href={site.primaryCta.href}>{site.primaryCta.label}</a><a class="button button--secondary" href="/contact/">تواصل معنا</a></div></div></div></div></section>
