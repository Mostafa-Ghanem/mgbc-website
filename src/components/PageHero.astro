---
interface Props { eyebrow?:string; title:string; description:string; parent?:{label:string;href:string} }
const { title, description, parent }=Astro.props;
---
<section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span class="breadcrumb-separator" aria-hidden="true">/</span>{parent&&<><a href={parent.href}>{parent.label}</a><span class="breadcrumb-separator" aria-hidden="true">/</span></>}<span aria-current="page">{title}</span></nav><h1>{title}</h1><p>{description}</p></div></section>