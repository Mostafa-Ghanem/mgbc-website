---
import site from '@/data/settings/site.json';
import Icon from './Icon.astro';
const booking = site.booking;
---
<div class="booking-layout" data-booking-provider={booking.provider} data-booking-url={booking.url} data-lead-email={site.email} data-brand-color={booking.brandColor}>
  <section class="assessment-card" aria-labelledby="assessment-title">
    <span class="badge">تقييم مجاني · 3 دقائق</span>
    <h2 id="assessment-title" class="section-title" style="font-size:clamp(1.9rem,4vw,2.6rem)">قيّم جاهزيتك المالية والضريبية</h2>
    <p class="section-lead" style="font-size:1rem">أجب عن أسئلة قصيرة لتحصل على تشخيص أولي وتوصية بالخطوة التالية قبل حجز الجلسة.</p>
    <div class="assessment-progress" aria-hidden="true"><span style="width:33%"></span></div>
    <form id="lead-assessment">
      <div class="assessment-step" data-step="1">
        <div class="form-grid">
          <div class="field"><label for="lead-name">الاسم</label><input id="lead-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="lead-email">البريد الإلكتروني</label><input id="lead-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="lead-company">اسم الشركة أو المشروع</label><input id="lead-company" name="company" autocomplete="organization" required /></div>
          <div class="field"><label for="lead-size">حجم الفريق</label><select id="lead-size" name="companySize" required><option value="">اختر</option><option>1–5</option><option>6–20</option><option>21–50</option><option>أكثر من 50</option></select></div>
          <div class="field field--full"><label for="lead-service">ما الخدمة الأقرب لاحتياجك؟</label><select id="lead-service" name="service" required><option value="">اختر الخدمة</option><option>استشارات مالية</option><option>استشارات ضريبية</option><option>دراسة جدوى</option><option>غير متأكد وأحتاج إلى تشخيص</option></select></div>
        </div>
        <div class="assessment-actions"><span></span><button class="btn btn--dark" type="button" data-next>التالي <Icon name="arrow" /></button></div>
      </div>
      <div class="assessment-step" data-step="2" hidden>
        <p style="font-weight:800;color:var(--navy-950)">اختر الإجابة الأقرب لوضعك الحالي:</p>
        <div class="field field--full"><label>هل توجد تقارير مالية دورية تساعد الإدارة على اتخاذ القرار؟</label><div class="choice-grid"><div class="choice"><input id="q1y" type="radio" name="q1" value="2" required/><label for="q1y">نعم، بانتظام</label></div><div class="choice"><input id="q1n" type="radio" name="q1" value="0"/><label for="q1n">لا أو بصورة غير منتظمة</label></div></div></div>
        <div class="field field--full" style="margin-top:18px"><label>هل التدفقات النقدية المتوقعة للأشهر القادمة واضحة؟</label><div class="choice-grid"><div class="choice"><input id="q2y" type="radio" name="q2" value="2" required/><label for="q2y">نعم</label></div><div class="choice"><input id="q2n" type="radio" name="q2" value="0"/><label for="q2n">لا / غير متأكد</label></div></div></div>
        <div class="field field--full" style="margin-top:18px"><label>هل الوضع الزكوي والضريبي موثق ومراجع قبل الاستحقاقات؟</label><div class="choice-grid"><div class="choice"><input id="q3y" type="radio" name="q3" value="2" required/><label for="q3y">نعم</label></div><div class="choice"><input id="q3n" type="radio" name="q3" value="0"/><label for="q3n">لا / توجد مخاطر</label></div></div></div>
        <div class="field field--full" style="margin-top:18px"><label>هل القرارات الاستثمارية تُبنى على سيناريوهات وأرقام موثقة؟</label><div class="choice-grid"><div class="choice"><input id="q4y" type="radio" name="q4" value="2" required/><label for="q4y">نعم</label></div><div class="choice"><input id="q4n" type="radio" name="q4" value="0"/><label for="q4n">غالبًا لا</label></div></div></div>
        <div class="field field--full" style="margin-top:18px"><label for="lead-challenge">ما التحدي الأهم الآن؟</label><textarea id="lead-challenge" name="challenge" required placeholder="مثال: ضعف السيولة، التزام ضريبي، قرار توسع..."></textarea></div>
        <div class="assessment-actions"><button class="btn btn--ghost" type="button" data-prev>السابق</button><button class="btn btn--primary" type="submit">اعرض النتيجة</button></div>
      </div>
      <div class="assessment-step result-box" data-step="3" hidden aria-live="polite">
        <div class="score-ring"><strong><span id="score-value">0</span>%</strong></div><h3 id="result-title"></h3><p id="result-copy"></p><div class="recommendations"><strong>التوصية الأولية</strong><p id="result-recommendation" style="margin-bottom:0"></p></div><button class="btn btn--primary" type="button" id="show-calendar"><Icon name="calendar" />اختر موعد الجلسة المجانية</button><button class="btn btn--ghost" type="button" id="restart-assessment" style="margin-top:10px">إعادة التقييم</button>
      </div>
    </form>
  </section>
  <aside class="booking-card" id="booking-card" aria-labelledby="booking-title">
    <span class="eyebrow">الخطوة التالية</span><h2 id="booking-title" class="section-title" style="font-size:clamp(1.9rem,4vw,2.6rem)">{booking.headline}</h2><p>{booking.description}</p>
    <div id="booking-container" class="booking-placeholder"><div><Icon name="calendar" class="icon"/><h3>أكمل التقييم أولًا</h3><p>بعد عرض النتيجة سنفتح لك جدول المواعيد مع تعبئة بياناتك تلقائيًا لتقليل الخطوات.</p></div></div>
  </aside>
</div>
<script is:inline>
  const root=document.querySelector('[data-booking-provider]'); const form=document.querySelector('#lead-assessment'); const progress=document.querySelector('.assessment-progress span'); const steps=[...document.querySelectorAll('.assessment-step')];
  let current=1; let leadData={}; const show=(step)=>{current=step;steps.forEach(el=>el.hidden=Number(el.dataset.step)!==step);if(progress)progress.style.width=`${step*33.333}%`;};
  document.querySelector('[data-next]')?.addEventListener('click',()=>{const required=[...steps[0].querySelectorAll('[required]')];if(required.every(el=>el.reportValidity()))show(2);}); document.querySelector('[data-prev]')?.addEventListener('click',()=>show(1));
  form?.addEventListener('submit',(event)=>{event.preventDefault(); if(!form.reportValidity())return; const data=new FormData(form); leadData=Object.fromEntries(data.entries()); const points=['q1','q2','q3','q4'].reduce((sum,key)=>sum+Number(data.get(key)||0),0); const score=Math.round(points/8*100); document.querySelector('#score-value').textContent=String(score); document.querySelector('.score-ring')?.style.setProperty('--score',`${score}%`); let title,copy,rec;if(score>=75){title='أساس جيد يحتاج إلى تطوير مستمر';copy='لديك مستوى جيد من الانضباط المالي، ويمكن للجلسة أن تركز على تحسين القرارات والتوسع.';rec='مراجعة فرص التحسين وبناء مؤشرات تساعد الإدارة على التوسع بثقة.'}else if(score>=40){title='توجد فجوات مؤثرة في وضوح القرار';copy='بعض الأساسيات موجودة، لكن غياب الترابط بينها قد يسبب قرارات متأخرة أو مخاطر غير مرئية.';rec='جلسة تشخيص مركزة لتحديد أول ثلاث أولويات قابلة للتنفيذ.'}else{title='الحاجة إلى تدخل منظم أصبحت أولوية';copy='الاعتماد على معلومات غير منتظمة يرفع مخاطر السيولة والالتزام والقرار الاستثماري.';rec='البدء بخريطة وضع حالي ثم خطة مالية وضريبية واضحة قصيرة المدى.'}document.querySelector('#result-title').textContent=title;document.querySelector('#result-copy').textContent=copy;document.querySelector('#result-recommendation').textContent=rec;leadData.score=String(score);leadData.result=title;localStorage.setItem('mgbcLeadAssessment',JSON.stringify(leadData));show(3);});
  const mountBooking=()=>{const container=document.querySelector('#booking-container');if(!container||!root)return;const provider=root.dataset.bookingProvider;const url=root.dataset.bookingUrl;const email=root.dataset.leadEmail;if(!url){const subject=encodeURIComponent('طلب جلسة تشخيص مجانية - '+(leadData.company||''));const body=encodeURIComponent(`الاسم: ${leadData.name||''}\nالبريد: ${leadData.email||''}\nالشركة: ${leadData.company||''}\nحجم الفريق: ${leadData.companySize||''}\nالخدمة: ${leadData.service||''}\nالتحدي: ${leadData.challenge||''}\nنتيجة التقييم: ${leadData.score||''}%`);container.className='booking-placeholder';container.innerHTML=`<div><h3>أرسل طلب الجلسة الآن</h3><p>سيتم تفعيل اختيار الموعد المباشر فور ربط حساب Cal.com. يمكنك الآن إرسال بيانات التقييم إلى فريق MGBC.</p><a class="btn btn--primary" href="mailto:${email}?subject=${subject}&body=${body}">إرسال طلب الاستشارة</a></div>`;return;}const params=new URLSearchParams({name:leadData.name||'',email:leadData.email||'',company:leadData.company||'',notes:`${leadData.challenge||''} | Assessment: ${leadData.score||''}%`,utm_source:new URLSearchParams(location.search).get('utm_source')||'website'});container.className='booking-embed';if(provider==='calendly'){container.innerHTML=`<div class="calendly-inline-widget" data-url="${url}?${params.toString()}" style="min-width:320px;height:700px"></div>`;if(!document.querySelector('script[src*="calendly.com/assets/external/widget.js"]')){const s=document.createElement('script');s.src='https://assets.calendly.com/assets/external/widget.js';s.async=true;document.body.appendChild(s);}}else{const src=`${url}${url.includes('?')?'&':'?'}${params.toString()}&embed=1`;container.innerHTML=`<iframe title="حجز جلسة استشارية" loading="lazy" src="${src}" allow="camera; microphone; fullscreen"></iframe>`;}container.scrollIntoView({behavior:'smooth',block:'start'});};
  document.querySelector('#show-calendar')?.addEventListener('click',mountBooking);document.querySelector('#restart-assessment')?.addEventListener('click',()=>{form.reset();leadData={};show(1);});
</script>
