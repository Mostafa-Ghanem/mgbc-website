---
import site from '@/data/settings/site.json';import Icon from './Icon.astro';const booking=site.booking;const bookingReady=Boolean(booking.url?.trim());
---
<div class="booking-layout" data-booking-provider={booking.provider} data-booking-url={booking.url} data-booking-ready={String(bookingReady)} data-brand-color={booking.brandColor}>
<section class="assessment-card" aria-labelledby="assessment-title"><div class="assessment-intro"><h2 id="assessment-title" class="assessment-title">قيّم جاهزيتك المالية والضريبية</h2><p class="assessment-copy">تقييم مجاني يستغرق نحو 3 دقائق. أجب عن الأسئلة لتحصل على تشخيص أولي وتوصية بالخطوة التالية.</p></div><div class="assessment-progress" role="progressbar" aria-label="تقدم التقييم" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1"><span style="width:33.333%"></span></div><form id="lead-assessment" novalidate><div class="hp-field" aria-hidden="true"><label for="assessment-website">الموقع الإلكتروني</label><input id="assessment-website" name="website" tabindex="-1" autocomplete="off"/></div>
<div class="assessment-step" data-step="1"><div class="form-grid"><div class="field"><label for="lead-name">الاسم</label><input id="lead-name" name="name" autocomplete="name" maxlength="100" required placeholder="مثال: محمد أحمد…"/></div><div class="field"><label for="lead-email">البريد الإلكتروني</label><input id="lead-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" maxlength="160" required placeholder="name@company.com…"/></div><div class="field"><label for="lead-phone">رقم الجوال <span class="form-note">(اختياري)</span></label><input id="lead-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" placeholder="05xxxxxxxx…"/></div><div class="field"><label for="lead-company">اسم الشركة أو المشروع</label><input id="lead-company" name="company" autocomplete="organization" maxlength="140" required placeholder="اسم المنشأة…"/></div><div class="field"><label for="lead-size">حجم الفريق</label><select id="lead-size" name="companySize" autocomplete="off" required><option value="">اختر الحجم</option><option value="1–5">1–5</option><option value="6–20">6–20</option><option value="21–50">21–50</option><option value="أكثر من 50">أكثر من 50</option></select></div><div class="field"><label for="lead-service">الخدمة الأقرب لاحتياجك</label><select id="lead-service" name="service" autocomplete="off" required><option value="">اختر الخدمة</option><option>الاستشارات المالية</option><option>الاستشارات الضريبية</option><option>دراسات الجدوى</option><option>غير متأكد وأحتاج إلى تشخيص</option></select></div></div><div class="assessment-actions"><span aria-hidden="true"></span><button class="btn btn--dark" type="button" data-next>متابعة التقييم <Icon name="arrow"/></button></div></div>
<div class="assessment-step" data-step="2" hidden><fieldset class="assessment-question"><legend class="field-label">هل توجد تقارير مالية دورية تساعد الإدارة على اتخاذ القرار؟</legend><div class="choice-grid"><div class="choice"><input id="q1y" type="radio" name="q1" value="2" required/><label for="q1y">نعم، بانتظام</label></div><div class="choice"><input id="q1n" type="radio" name="q1" value="0"/><label for="q1n">لا أو بصورة غير منتظمة</label></div></div></fieldset><fieldset class="assessment-question"><legend class="field-label">هل التدفقات النقدية المتوقعة للأشهر القادمة واضحة؟</legend><div class="choice-grid"><div class="choice"><input id="q2y" type="radio" name="q2" value="2" required/><label for="q2y">نعم</label></div><div class="choice"><input id="q2n" type="radio" name="q2" value="0"/><label for="q2n">لا / غير متأكد</label></div></div></fieldset><fieldset class="assessment-question"><legend class="field-label">هل الوضع الزكوي والضريبي موثق ومراجع قبل الاستحقاقات؟</legend><div class="choice-grid"><div class="choice"><input id="q3y" type="radio" name="q3" value="2" required/><label for="q3y">نعم</label></div><div class="choice"><input id="q3n" type="radio" name="q3" value="0"/><label for="q3n">لا / توجد مخاطر</label></div></div></fieldset><fieldset class="assessment-question"><legend class="field-label">هل القرارات الاستثمارية تُبنى على سيناريوهات وأرقام موثقة؟</legend><div class="choice-grid"><div class="choice"><input id="q4y" type="radio" name="q4" value="2" required/><label for="q4y">نعم</label></div><div class="choice"><input id="q4n" type="radio" name="q4" value="0"/><label for="q4n">غالبًا لا</label></div></div></fieldset><div class="field field--full assessment-question"><label for="lead-challenge">ما التحدي الأهم الآن؟</label><textarea id="lead-challenge" name="challenge" maxlength="1200" required placeholder="مثال: ضعف السيولة، التزام ضريبي، قرار توسع…"></textarea></div><div class="assessment-actions"><button class="btn btn--ghost" type="button" data-prev>العودة للبيانات</button><button class="btn btn--primary" type="submit" id="assessment-submit">اعرض النتيجة</button></div><p id="assessment-status" class="form-status" role="status" aria-live="polite"></p></div>
<div class="assessment-step result-box" data-step="3" hidden aria-live="polite"><div class="score-ring" aria-label="نتيجة التقييم"><strong><span id="score-value">0</span>%</strong></div><h3 id="result-title"></h3><p id="result-copy"></p><div class="recommendations"><strong>التوصية الأولية</strong><p id="result-recommendation"></p></div><p id="lead-save-state" class="lead-save-state" role="status" aria-live="polite"></p>{bookingReady?<button class="btn btn--primary" type="button" id="show-calendar"><Icon name="calendar"/>اختر موعد الجلسة</button>:<div class="recommendations"><strong>الخطوة التالية</strong><p>تم تسجيل طلب التقييم. سيراجع فريق MGBC البيانات لتحديد أنسب نقطة بداية للتواصل معك.</p></div>}<button class="btn btn--ghost" type="button" id="retry-save" hidden>إعادة إرسال البيانات</button><button class="btn btn--ghost" type="button" id="restart-assessment">إعادة التقييم</button></div></form></section>
<aside class="booking-card" id="booking-card" aria-labelledby="booking-title"><h2 id="booking-title">ماذا يحدث بعد التقييم؟</h2><p>الهدف ليس جمع بيانات أكثر، بل إعطاؤك نقطة بداية واضحة قبل أي نقاش استشاري.</p><div class="booking-points"><div class="booking-point"><span class="check-icon"><Icon name="check"/></span><div><strong>نتيجة فورية</strong><p>تظهر لك درجة أولية مبنية على إجاباتك.</p></div></div><div class="booking-point"><span class="check-icon"><Icon name="check"/></span><div><strong>توصية أولية</strong><p>نحدد نوع الفجوة والخطوة الأكثر منطقية للبدء.</p></div></div><div class="booking-point"><span class="check-icon"><Icon name="check"/></span><div><strong>متابعة بشرية</strong><p>بعد استلام البيانات يمكن لفريق MGBC مراجعة الاحتياج والتواصل معك.</p></div></div></div>{bookingReady&&<div id="booking-container" class="booking-embed" hidden></div>}</aside></div>
<script is:inline>
const root=document.querySelector('[data-booking-provider]');const form=document.querySelector('#lead-assessment');const progress=document.querySelector('.assessment-progress');const progressFill=progress?.querySelector('span');const steps=[...document.querySelectorAll('.assessment-step')];const submitButton=document.querySelector('#assessment-submit');const status=document.querySelector('#assessment-status');const saveState=document.querySelector('#lead-save-state');const retryButton=document.querySelector('#retry-save');let leadData={};let lastPayload=null;const setTextState=(node,message,state='')=>{if(!node)return;node.textContent=message;node.dataset.state=state};const show=(step)=>{steps.forEach((el)=>{el.hidden=Number(el.dataset.step)!==step});if(progressFill)progressFill.style.width=`${Math.min(step,3)*33.333}%`;progress?.setAttribute('aria-valuenow',String(step))};const focusFirstInvalid=(scope)=>{const invalid=scope?.querySelector(':invalid');if(invalid){invalid.focus();invalid.reportValidity();return true}return false};const attribution=()=>{const q=new URLSearchParams(location.search);return{utmSource:q.get('utm_source')||'',utmMedium:q.get('utm_medium')||'',utmCampaign:q.get('utm_campaign')||'',utmContent:q.get('utm_content')||'',utmTerm:q.get('utm_term')||'',landingPage:location.href,referrer:document.referrer||''}};const saveLead=async(payload)=>{const response=await fetch('/api/leads',{method:'POST',headers:{'content-type':'application/json','accept':'application/json'},body:JSON.stringify(payload)});const data=await response.json().catch(()=>({}));if(!response.ok||!data.ok)throw new Error(data.message||'تعذر حفظ التقييم الآن.');return data};const selectedService=new URLSearchParams(location.search).get('service');const serviceSelect=document.querySelector('#lead-service');if(selectedService&&serviceSelect&&[...serviceSelect.options].some((option)=>option.value===selectedService))serviceSelect.value=selectedService;document.querySelector('[data-next]')?.addEventListener('click',()=>{if(!focusFirstInvalid(steps[0]))show(2)});document.querySelector('[data-prev]')?.addEventListener('click',()=>show(1));const renderResult=(score)=>{document.querySelector('#score-value').textContent=String(score);document.querySelector('.score-ring')?.style.setProperty('--score',`${score}%`);let title,copy,rec;if(score>=75){title='أساس جيد يحتاج إلى تطوير مستمر';copy='لديك مستوى جيد من الانضباط المالي، ويمكن أن تركز الخطوة التالية على تحسين القرارات والتوسع.';rec='مراجعة فرص التحسين وبناء مؤشرات تساعد الإدارة على التوسع بثقة.'}else if(score>=40){title='توجد فجوات مؤثرة في وضوح القرار';copy='بعض الأساسيات موجودة، لكن غياب الترابط بينها قد يسبب قرارات متأخرة أو مخاطر غير مرئية.';rec='تشخيص مركز لتحديد أول ثلاث أولويات قابلة للتنفيذ.'}else{title='الحاجة إلى تدخل منظم أصبحت أولوية';copy='الاعتماد على معلومات غير منتظمة يرفع مخاطر السيولة والالتزام والقرار الاستثماري.';rec='البدء بخريطة وضع حالي ثم خطة مالية وضريبية واضحة قصيرة المدى.'}document.querySelector('#result-title').textContent=title;document.querySelector('#result-copy').textContent=copy;document.querySelector('#result-recommendation').textContent=rec;return title};form?.addEventListener('submit',async(event)=>{event.preventDefault();if(focusFirstInvalid(form))return;const data=new FormData(form);const points=['q1','q2','q3','q4'].reduce((sum,key)=>sum+Number(data.get(key)||0),0);const score=Math.round(points/8*100);const title=renderResult(score);leadData=Object.fromEntries(data.entries());leadData.score=String(score);leadData.result=title;lastPayload={...leadData,...attribution(),source:'consultation_assessment',bookingProvider:root?.dataset.bookingProvider||''};submitButton.disabled=true;submitButton.textContent='جارٍ حفظ التقييم…';setTextState(status,'جارٍ حفظ إجاباتك…');try{await saveLead(lastPayload);localStorage.setItem('mgbcLeadAssessment',JSON.stringify(leadData));setTextState(saveState,'تم استلام التقييم بنجاح.','success');retryButton.hidden=true}catch(error){setTextState(saveState,`${error.message} يمكنك إعادة الإرسال دون فقد إجاباتك.`,'error');retryButton.hidden=false}finally{submitButton.disabled=false;submitButton.textContent='اعرض النتيجة';setTextState(status,'');show(3)}});retryButton?.addEventListener('click',async()=>{if(!lastPayload)return;retryButton.disabled=true;retryButton.textContent='جارٍ إعادة الإرسال…';try{await saveLead(lastPayload);setTextState(saveState,'تم استلام التقييم بنجاح.','success');retryButton.hidden=true}catch(error){setTextState(saveState,`${error.message} أعد المحاولة بعد قليل.`,'error')}finally{retryButton.disabled=false;retryButton.textContent='إعادة إرسال البيانات'}});const mountBooking=()=>{const container=document.querySelector('#booking-container');if(!container||!root)return;const provider=root.dataset.bookingProvider;const url=root.dataset.bookingUrl;if(!url)return;const params=new URLSearchParams({name:leadData.name||'',email:leadData.email||'',company:leadData.company||'',notes:`${leadData.challenge||''} | Assessment: ${leadData.score||''}%`,utm_source:new URLSearchParams(location.search).get('utm_source')||'website'});container.hidden=false;if(provider==='calendly'){container.innerHTML=`<div class="calendly-inline-widget" data-url="${url}?${params.toString()}" style="min-width:320px;height:700px"></div>`;if(!document.querySelector('script[src*="calendly.com/assets/external/widget.js"]')){const s=document.createElement('script');s.src='https://assets.calendly.com/assets/external/widget.js';s.async=true;document.body.appendChild(s)}}else{const src=`${url}${url.includes('?')?'&':'?'}${params.toString()}&embed=1`;container.innerHTML=`<iframe title="حجز جلسة استشارية" loading="lazy" src="${src}" allow="camera; microphone; fullscreen"></iframe>`}container.scrollIntoView({behavior:'smooth',block:'start'})};document.querySelector('#show-calendar')?.addEventListener('click',mountBooking);document.querySelector('#restart-assessment')?.addEventListener('click',()=>{form.reset();leadData={};lastPayload=null;setTextState(saveState,'');retryButton.hidden=true;show(1);document.querySelector('#lead-name')?.focus()});
</script>