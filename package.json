{
  "name": "mgbc-website",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "review:ui:start": "node .agents/skills/ui-review-loop/scripts/round.mjs start",
    "review:ui:run": "node .agents/skills/ui-review-loop/scripts/round.mjs run --",
    "review:ui:stop": "node .agents/skills/ui-review-loop/scripts/round.mjs stop",
    "review:ui:abort": "node .agents/skills/ui-review-loop/scripts/round.mjs abort",
    "review:ui:pending": "node .agents/skills/ui-review-loop/scripts/round.mjs pending --json",
    "review:ui:server": "node .agents/skills/ui-review-loop/scripts/server.mjs open --project ."
  },
  "dependencies": {
    "astro": "5.18.2",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lucide/astro": "1.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "agent-browser": "0.32.4",
    "typescript": "5.9.2"
  }
}
